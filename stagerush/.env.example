# ─── StageRush Environment Configuration ───────────────────────────

# Server
NODE_ENV=production
PORT=4100
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgresql://stagerush:stagerush_secret@postgres:5432/stagerush
DB_POOL_MIN=5
DB_POOL_MAX=30

# Redis
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-to-a-very-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGIN=http://localhost:3000

# Queue Configuration
QUEUE_DRAIN_RATE=100
SEAT_LOCK_TTL_MS=420000
BOOKING_TOKEN_TTL_MS=600000

# Payment (Stripe - for production)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Logging
LOG_LEVEL=info
